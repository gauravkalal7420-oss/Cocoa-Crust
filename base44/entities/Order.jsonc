{
  "name": "Order",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "pickup_date": {
      "type": "string"
    },
    "pickup_slot": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "item_count": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "collected",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "red"
      ],
      "default": "pending"
    }
  },
  "required": [
    "reference",
    "customer_name",
    "email",
    "pickup_date",
    "total"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}